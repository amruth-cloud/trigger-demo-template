# Copy this file to .env and fill in the values. Never commit .env.

# Tavily web search key (starts with tvly-). Free tier available at app.tavily.com
TAVILY_API_KEY=

# Anthropic API key (starts with sk-ant-). console.anthropic.com > API Keys. Paid usage.
ANTHROPIC_API_KEY=

# Notion internal integration secret. notion.so/profile/integrations
# Share your leads database with this integration (database "..." menu > Connections).
NOTION_API_KEY=

# ID of your Notion leads database (the 32-character part of the database URL).
NOTION_LEADS_DATABASE_ID=
